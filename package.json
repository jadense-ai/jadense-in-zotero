{
  "name": "jadense-in-zotero",
  "version": "0.6.15",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "brand:sync": "node ./scripts/brand-assets.mjs",
    "brand:check": "node ./scripts/brand-assets.mjs --check",
    "build": "npm run brand:sync && npm run typecheck && npm run release:package && npm run release:verify",
    "lint": "eslint .",
    "release:package": "node ./scripts/build.mjs",
    "release:verify": "node ./scripts/verify-release.mjs",
    "release:notes:check": "node ./scripts/check-release-notes.mjs",
    "smoke:installed": "node ./scripts/smoke-installed-xpi.mjs",
    "smoke:research": "node ./scripts/smoke-research.mjs",
    "preview:research": "node ./scripts/preview-research.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jsdom": "28.0.0",
    "@types/node": "^20.19.33",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "jsdom": "28.1.0",
    "jszip": "^3.10.1",
    "sharp": "0.34.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "katex": "0.16.47",
    "markdown-it": "15.0.1",
    "pdfjs-dist": "4.10.38"
  }
}
